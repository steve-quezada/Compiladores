/**
 * BYACC/J Semantic Value for parser: Parser
 * This class provides some of the functionality
 * of the yacc/C 'union' directive
 */
class ParserVal {

  Token id;          /* Para identificadores */
  Token val;         /* Para valores literales */
  AtribExp AtribExp; /* Para expresiones y otros no terminales */
  AtribExp lista;    /* Para listas (argumentos, parámetros) */

  public ParserVal(Token value) {
    this.id = value;
    this.val = value;
  }

  public ParserVal(AtribExp value) {
    this.AtribExp = value;
    this.lista = value;
  }

  /**
   * integer value of this 'union'
   */
  public int ival;

  /**
   * double value of this 'union'
   */
  public double dval;

  /**
   * string value of this 'union'
   */
  public String sval;

  /**
   * object value of this 'union'
   */
  public Object obj;

  // #############################################
  // ## C O N S T R U C T O R S
  // #############################################
  /**
   * Initialize me without a value
   */
  public ParserVal() {
  }

  /**
   * Initialize me as an int
   */
  public ParserVal(int val) {
    ival = val;
  }

  /**
   * Initialize me as a double
   */
  public ParserVal(double val) {
    dval = val;
  }

  /**
   * Initialize me as a string
   */
  public ParserVal(String val) {
    sval = val;
  }

  /**
   * Initialize me as an Object
   */
  public ParserVal(Object val) {
    obj = val;
  }
}
// end class

