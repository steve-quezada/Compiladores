/**
 * Este analizador implementa la gramática y el análisis semántico para un 
 * lenguaje de programación. Proporciona soporte para:
 *
 * - Análisis sintáctico mediante YACC/BYACCJ
 * - Verificación de tipos estática
 * - Manejo de ámbitos y símbolos
 * - Generación de código intermedio
 * - Control de errores y recuperación
 *
 * El parser trabaja en conjunto con:
 * - Analizador léxico (JFlex)
 * - Tabla de símbolos
 * - Sistema de tipos
 * - Generador de código intermedio
 * 
 * @author steve-quezada
 * @author etnicst
 */

%{
// Importaciones del sistema
import java.io.*;              // Entrada/salida estándar
import java.util.Stack;        // Estructuras de pila
import java.util.List;         // Listas dinámicas
import java.util.ArrayList;    // Implementación de listas

// Importaciones del proyecto
import src.Analizador_Sintactico_BYACCJ.tablas.Tablas.*;    // Gestión de tablas
import src.Analizador_Sintactico_BYACCJ.pilas.Pilas.*;      // Gestión de pilas
import src.Analizador_Sintactico_BYACCJ.utils.Colors;       // Utilidades de formato
import src.Analizador_Sintactico_BYACCJ.jflex.Token;        // Definición de tokens
import src.Analizador_Sintactico_BYACCJ.jflex.ClaseLexica;  // Tipos de tokens

/**
 * Clase AtribExp - Atributos para Expresiones
 *
 * Mantiene la información semántica asociada a cada no terminal
 * durante el análisis sintáctico y la generación de código.
 */
class AtribExp {
    String dir;         // Dirección temporal del resultado
    int tipo;           // Tipo semántico
    String codigo;      // Código intermedio generado
    boolean esArray;    // Indicador de acceso a array
    String base;        // Dirección base para arrays/structs
    String id;          // Nombre del identificador
    List<Object> lista; // Lista de argumentos/parámetros

    /**
     * Constructor por defecto
     * Inicializa todos los campos con valores predeterminados seguros
     */
    AtribExp() {
        this.dir = "";
        this.tipo = TablaTipos.T_ERROR;
        this.codigo = "";
        this.esArray = false;
        this.base = "";
        this.id = "";
        this.lista = new ArrayList<>();
    }

    /**
     * Constructor de copia
     * @param other Instancia a copiar
     */
    AtribExp(AtribExp other) {
        this.dir = other.dir;
        this.tipo = other.tipo;
        this.codigo = other.codigo;
        this.esArray = other.esArray;
        this.base = other.base;
        this.id = other.id;
    }
}

