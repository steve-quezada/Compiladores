}

/**
 * Verifica si existe un identificador en algún ámbito
 * @param id Identificador a buscar
 * @return boolean true si existe el identificador
 */
public boolean existe(String id) {
    for (int i = pilaTs.size() - 1; i >= 0; i--) {
        if (pilaTs.get(i).existe(id)) {
            return true;
        }
    }
    return false;
}

/**
 * Obtiene el tipo de un identificador
 * @param id Identificador a consultar
 * @return int Tipo del identificador o T_ERROR si no existe
 */
public int getTipo(String id) {
    for (int i = pilaTs.size() - 1; i >= 0; i--) {
        if (pilaTs.get(i).existe(id)) {
            return pilaTs.get(i).getTipo(id);
        }
    }
    return TablaTipos.T_ERROR;
}

private void printSemanticInfo(String fase, String detalle, String color) {
    // Define un ancho mínimo y máximo para la tabla
    int minWidth = 40;  // Ancho mínimo
    int maxWidth = 50;  // Ancho máximo
    
    // Agregar espacios al título
    String tituloFormateado = " " + fase + " ";
    
    // Dividir el detalle en líneas si contiene saltos de línea
    String[] lineas = detalle.split("\n");
    
    // Calcular el ancho necesario (considerando el título con espacios)
    int maxLength = tituloFormateado.length();
    for (String linea : lineas) {
        maxLength = Math.max(maxLength, linea.length());
    }
    
    // Ajustar el ancho dentro de los límites establecidos
    maxLength = Math.min(Math.max(maxLength + 4, minWidth), maxWidth);
    
    // Calcular el padding para centrar el título
    int espaciosTotal = maxLength - tituloFormateado.length();
    int espaciosIzq = espaciosTotal / 2;
    int espaciosDer = espaciosTotal - espaciosIzq;
    
    // Crear bordes
    String bordeTop = "╔" + "═".repeat(espaciosIzq) + tituloFormateado + "═".repeat(espaciosDer) + "╗";
    String bordeMiddle = "╠" + "═".repeat(maxLength) + "╣";
    String bordeBottom = "╚" + "═".repeat(maxLength) + "╝";
    
    // Imprimir la tabla
    Colors.println("\n" + bordeTop, color);
    
    // Imprimir cada línea del detalle centrada
    for (int i = 0; i < lineas.length; i++) {
        if (i > 0) Colors.println(bordeMiddle, color);
        
        // Centrar el contenido
        int espaciosContenido = maxLength - lineas[i].length();
        int espaciosIzqContenido = espaciosContenido / 2;
        int espaciosDerContenido = espaciosContenido - espaciosIzqContenido;
        String lineaCentrada = " ".repeat(espaciosIzqContenido) + lineas[i] + " ".repeat(espaciosDerContenido);
        
        Colors.println("║" + lineaCentrada + "║", color);
    }
    
    Colors.println(bordeBottom, color);
}
