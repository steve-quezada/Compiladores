/* CÓDIGO DE SOPORTE
 *
 * Implementación de todas las funciones auxiliares
 * necesarias para el análisis semántico y la generación de código
 */

// Variables globales para el análisis semántico
private TablaTipos tablaTipos;
private PilaTs pilaTs;
private PilaDir pilaDir;
private int dir;
private int tipoReturnFunc;

// Pilas para control de flujo
private Stack<String> pilaLabelTrue = new Stack<>();
private Stack<String> pilaLabelFalse = new Stack<>();
private Stack<String> pilaLabelNext = new Stack<>();
private int labelCount = 0;
private int tempCount = 0;
private Lexer lexer;
private Token currentToken;
private List<String> listaVariables = new ArrayList<>();
private boolean hasErrors = false;

/**
 * Genera una nueva etiqueta única para el control de flujo
 * @return String Nueva etiqueta en formato
 */
private String newLabel() {
    String label = "L" + (++labelCount);
    Colors.println("  • Nueva etiqueta: " + label, Colors.GRAY_LIGHT);
    return label;
}

/**
 * Genera y registra una línea de código intermedio
 * @param code Instrucción de código intermedio a generar
 */
private void genCode(String code) {
    Colors.println("  ├─ " + code, Colors.CYAN);
}

/**
 * Imprime una etiqueta de control de flujo
 * @param label Etiqueta a imprimir
 */
private void label(String label) {
    System.out.println(label + ":");
}

/**
 * Genera una nueva variable temporal
 * @return String Nombre de la nueva variable temporal
 */
private String nuevaTemporal() {
    String temp = "t" + (++tempCount);
    Colors.println("  │ Nueva temporal: " + temp, Colors.GRAY_LIGHT);
    return temp;
}

/**
 * Realiza la ampliación de tipos para conversiones implícitas
 * @param valor Valor a convertir
 * @param tipoOrigen Tipo original del valor
 * @param tipoDestino Tipo al que se debe convertir
 * @return String Expresión con la conversión de tipo
 */
private String ampliar(String valor, int tipoOrigen, int tipoDestino) {
    if (tipoOrigen == tipoDestino) return valor;
    return String.format("(%s)%s", tablaTipos.getName(tipoDestino), valor);
}

/**
 * Determina el tipo resultante de una operación entre dos tipos
 * @param tipo1 Primer tipo
 * @param tipo2 Segundo tipo
 * @return int Tipo resultante según las reglas de promoción
 */
private int max(int tipo1, int tipo2) {
    return tablaTipos.getTipoResultante(tipo1, tipo2);
}

/**
 * Constructor del parser
 * Inicializa el analizador léxico y las estructuras necesarias
 * @param input Flujo de entrada para el análisis
 */
public Parser(Reader input) {
    lexer = new Lexer(input);
    Colors.println("\n=== Inicio del Análisis ===", Colors.HIGH_INTENSITY + Colors.BLUE);
    Colors.println("1. Inicializando analizador sintáctico...", Colors.CYAN);
    Colors.println("2. Configurando tablas y estructuras...", Colors.CYAN);
    tipoReturnFunc = TablaTipos.T_ERROR;
}

/**
 * Reporta un error sintáctico
 * @param msg Mensaje de error
 */
private void yyerror(String msg) {
    error(msg, (currentToken != null ? currentToken.getLinea() : -1));
}

/**
 * Procesa y reporta un error detallado
 * @param msg Mensaje de error
 * @param linea Número de línea donde ocurrió el error
 */
private void error(String msg, int linea) {
    hasErrors = true;
    String lineaStr = (linea != -1 ? String.valueOf(linea) : "?");
    String token = (currentToken != null ? currentToken.getLexema() : "null");
    
    // Calcular la longitud máxima para el marco
    int maxLength = Math.max(
        Math.max(
            ("Error: " + msg).length(),
            ("Línea: " + lineaStr).length()
        ),
        ("Token: " + token).length()
    ) + 4;

    String border = "╔" + "═".repeat(maxLength) + "╗";
    String bottomBorder = "╚" + "═".repeat(maxLength) + "╝";

    // Imprimir el mensaje de error
    Colors.println("\n" + border, Colors.RED + Colors.HIGH_INTENSITY);
    Colors.println("║ " + padString("Error Sintáctico", maxLength-2) + " ║", Colors.RED);
    Colors.println("║ " + padString("Línea: " + lineaStr, maxLength-2) + " ║", Colors.RED);
    Colors.println("║ " + padString("Error: " + msg, maxLength-2) + " ║", Colors.RED);
    Colors.println("║ " + padString("Token: " + token, maxLength-2) + " ║", Colors.RED);
    Colors.println(bottomBorder, Colors.RED + Colors.HIGH_INTENSITY);

    // Imprimir mensaje de compilación fallida
    printBox("Compilación Fallida", new String[]{
        "El análisis ha finalizado con errores",
        "Revise los mensajes anteriores"
    }, Colors.RED);

    // Terminar el programa con código de error
    System.exit(1);
}

/**
 * Formatea y muestra un cuadro de mensaje
 * @param title Título del cuadro
 * @param content Contenido a mostrar
 * @param color Color para el formato
 */
private void printBox(String title, String[] content, String color) {
    int maxLength = title.length();
    for (String line : content) {
        maxLength = Math.max(maxLength, line.length());
    }
    maxLength += 4;

    String border = "╔" + "═".repeat(maxLength) + "╗";
    String middleBorder = "╠" + "═".repeat(maxLength) + "╣";
    String bottomBorder = "╚" + "═".repeat(maxLength) + "╝";

    Colors.println("\n" + border, color);
    Colors.println("║ " + padString(title, maxLength-2) + " ║", color);
    Colors.println(middleBorder, color);
    
    for (String line : content) {
        Colors.println("║ " + padString(line, maxLength-2) + " ║", color);
    }
    
    Colors.println(bottomBorder, color);
}

/**
 * Verifica si hay errores en el análisis
 * @return boolean true si se encontraron errores, false en caso contrario
 */
public boolean hasErrors() {
    return hasErrors;
}

/**
 * Rellena una cadena con espacios hasta alcanzar la longitud especificada
 * @param str Cadena a rellenar
 * @param length Longitud deseada
 * @return String Cadena rellenada con espacios
 */
private String padString(String str, int length) {
    return String.format("%-" + length + "s", str);
}

/**
 * Obtiene el siguiente token del analizador léxico
 * @return int Código del token o 0 para EOF, -1 en caso de error
 */
private int yylex() {
    try {
        currentToken = lexer.yylex();
        if (currentToken == null || currentToken.getClaseLexica() == ClaseLexica.EOF) {
            return 0;
        }
        yylval = new ParserVal(currentToken);
        return currentToken.getClaseLexica().ordinal() + 257;
    } catch (IOException e) {
        Colors.println("Error de lectura: " + e.getMessage(), Colors.RED);
        return -1;
    }
}

// Método principal
public static void main(String args[]) {
    if (args.length < 1) {
        System.err.println("Uso: java Parser <archivo_entrada>");
        System.exit(1);
    }
    
    try {
        Parser parser = new Parser(new FileReader(args[0]));
        parser.yyparse();
    } catch (FileNotFoundException e) {
        System.err.println("Error: No se puede abrir el archivo " + args[0]);
    }
}

