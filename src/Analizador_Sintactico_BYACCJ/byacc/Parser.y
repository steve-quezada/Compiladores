// Sección de declaraciones Yacc
/* TOKENS Y PRECEDENCIAS */

// Símbolo inicial que define el punto de entrada de la gramática
%start programa

/* TOKENS PARA TIPOS DE DATOS BÁSICOS
 * Cada token representa un tipo de dato fundamental del lenguaje
 */
%token INT     // Tipo entero
%token FLOAT   // Tipo punto flotante
%token DOUBLE  // Tipo doble precisión
%token COMPLEX // Tipo número complejo
%token RUNE    // Tipo carácter Unicode
%token VOID    // Tipo vacío
%token STRING  // Tipo cadena de caracteres
%token STRUCT  // Tipo estructura
%token PTR     // Tipo puntero

/* Palabras reservadas */
%token FUNC IF ELSE WHILE DO BREAK RETURN SWITCH CASE DEFAULT
%token PRINT SCAN TRUE FALSE PROTO

/* Identificadores y literales */
%token <id> ID
%token <val> LIT_ENTERO
%token <val> LIT_FLOAT LIT_DOUBLE LIT_COMPLEX LIT_STRING LIT_RUNE

/* Operadores */
%token OR AND IGUAL DIFERENTE MENOR MENORIGUAL MAYORIGUAL MAYOR
%token MAS MENOS POR DIV MOD DIVINT NOT ASIG

/* Delimitadores */
%token PARI PARD CORI CORD LLAI LLAD COMA PYC PUNTO DOSP

/* Precedencia y asociatividad */
%left OR
%left AND
%left IGUAL DIFERENTE
%left MENOR MENORIGUAL MAYORIGUAL MAYOR
%left MAS MENOS
%left POR DIV MOD DIVINT
%right NOT
%right UMENOS

/* Tipos para no terminales */
%type <AtribExp> programa tipo basico compuesto exp
%type <AtribExp> parte_izquierda decl_var puntero lista_args
%type <lista> argumentos parametros lista_param
%type <AtribExp> lista_var arreglo estructurado
%type <AtribExp> bloque declaraciones instrucciones
%type <AtribExp> casos caso opcion sentencia
%type <AtribExp> localizacion predeterminado
%type <AtribExp> decl_proto decl_func

%%

/* REGLAS DE PRODUCCIÓN
 
 * Cada regla incluye:
 * 1. Documentación detallada
 * 2. Acciones semánticas
 * 3. Generación de código
 * 4. Manejo de errores
 */

/* Estructura básica del programa */
programa : 
        {
            // Inicialización de estructuras semánticas
            tablaTipos = new TablaTipos();
            pilaTs = new PilaTs();
            pilaDir = new PilaDir();
            dir = 0;
            // Crear tabla de símbolos global
            pilaTs.push(new TablaSimbolos());
            $$ = new AtribExp();
        }
        decl_proto decl_var decl_func
        { 
            $$ = new AtribExp();
            if (currentToken != null && currentToken.getClaseLexica() == ClaseLexica.EOF) {
                System.out.println("\nAnálisis sintáctico completado exitosamente.");
            }
        }
        ;

/* Declaraciones de prototipos */
decl_proto : PROTO tipo ID PARI argumentos PARD PYC
        {
            $$ = new AtribExp();
            // Registrar el prototipo en la tabla de símbolos global
            if (!pilaTs.bottom().existe($3.getLexema())) {
                pilaTs.bottom().add($3.getLexema(), -1, $2.tipo, "func", $5.lista);
                // Simplificar el mensaje mostrado
                printSemanticInfo("Declaración de Prototipo", 
                    "Nombre: " + $3.getLexema(), Colors.INDIGO);
            } else {
                yyerror("El prototipo " + $3.getLexema() + " ya fue declarado");
            }
        }
        decl_proto
        {
            $$ = new AtribExp();
        }
        | /* epsilon */
        {
            $$ = new AtribExp();
        }
        ;

/* Declaraciones de variables */
decl_var : tipo lista_var PYC
        {
            $$ = new AtribExp();
            $$.tipo = $1.tipo;
            // Actualizar tabla de símbolos con el tipo correcto
            for (String id : listaVariables) {
                if (pilaTs.top().existe(id)) {
                    pilaTs.top().setTipo(id, $1.tipo);
                }
            }
            procesarDeclaracionVariables($1.tipo);
        }
        decl_var
        {
            $$ = new AtribExp();
        }
        | /* epsilon */
        {
            $$ = new AtribExp();
        }
        ;

// Tipos de datos
tipo : basico compuesto
     {
         $$ = new AtribExp();
         if ($2.tipo != -1) { // Si hay un tipo compuesto
             $$.tipo = $2.tipo;
         } else {
             $$.tipo = $1.tipo; // Propagar el tipo básico
         }
         // Guardar el tipo actual para usarlo en lista_var
         yylval.AtribExp = $$;
     }
     | STRUCT LLAI 
     {
         // Crear nueva tabla de símbolos para la estructura
         pilaTs.push(new TablaSimbolos());
         pilaDir.push(dir);
         dir = 0;
     }
     decl_var LLAD
     {
         $$ = new AtribExp();
         TablaSimbolos tsStruct = pilaTs.top();
         pilaTs.pop();
         $$.tipo = tablaTipos.add("struct", tsStruct);
         dir = pilaDir.pop();
     }
     | puntero
     {
         $$ = new AtribExp();
         $$.tipo = $1.tipo;
     }
     ;

// Punteros
puntero : PTR basico
        {
            $$ = new AtribExp();
            $$.tipo = $2.tipo;
        }
        ;

// Tipos básicos
basico : INT    
       { 
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_INT; 
       }
       | FLOAT  
       { 
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_FLOAT; 
       }
       | DOUBLE 
       { 
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_DOUBLE; 
       }
       | COMPLEX 
       { 
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_COMPLEX; 
       }
       | RUNE   
       { 
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_RUNE; 
       }
       | VOID   
       { 
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_VOID; 
       }
       | STRING 
       { 
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_STRING; 
       }
       ;

// Tipos compuestos
compuesto : CORI LIT_ENTERO CORD compuesto
         {
             $$ = new AtribExp();
             if ($2.valor <= 0) {
                 yyerror("El tamaño del arreglo debe ser mayor a cero");
                 $$.tipo = TablaTipos.T_ERROR;
             } else {
                 $$.tipo = tablaTipos.add($2.valor, $4.tipo, "array");
             }
             $$.dir = "";
         }
         | /* epsilon */
         {
             $$ = new AtribExp();
             $$.tipo = -1;
         }
         ;

// Lista de variables
lista_var : lista_var COMA ID
         {
             if (!pilaTs.top().existe($3.getLexema())) {
                 $$ = new AtribExp();
                 $$.tipo = $1.tipo;
                 pilaTs.top().add($3.getLexema(), dir, $1.tipo, "var", null);
                 dir += tablaTipos.getTam($1.tipo);
             } else {
                 yyerror("La variable " + $3.getLexema() + " ya fue declarada");
             }
             listaVariables.add($3.getLexema());
         }
         | ID
         {
             if (!pilaTs.top().existe($1.getLexema())) {
                 $$ = new AtribExp();
                 int tipoActual = yylval.AtribExp != null ? yylval.AtribExp.tipo : TablaTipos.T_ERROR;
                 $$.tipo = tipoActual;
                 pilaTs.top().add($1.getLexema(), dir, tipoActual, "var", null);
                 dir += tablaTipos.getTam(tipoActual);
             } else {
                 yyerror("La variable " + $1.getLexema() + " ya fue declarada");
             }
             listaVariables.add($1.getLexema());
         }
         ;

/* Declaraciones de funciones */
decl_func : FUNC tipo ID 
         {
             // Pre-verificación de la función
             if (!pilaTs.bottom().existe($3.getLexema())) {
                 pilaTs.bottom().add($3.getLexema(), -1, $2.tipo, "func", new ArrayList<>());
             }
         }
         PARI argumentos PARD bloque
         {
             // Validación y configuración de la función
             if (pilaTs.bottom().existe($3.getLexema())) {
                 // Actualizar la información de argumentos
                 pilaTs.bottom().setInfo($3.getLexema(), $6.lista);
                 
                 // Crear nuevo ámbito para la función
                 pilaTs.push(new TablaSimbolos());
                 pilaDir.push(dir);
                 dir = 0;
                 tipoReturnFunc = $2.tipo;
                 
                 // Registrar los parámetros en el ámbito local
                 if ($6.lista != null) {
                     for (Object arg : $6.lista) {
                         if (arg instanceof Argumento) {
                             Argumento argumento = (Argumento) arg;
                             pilaTs.top().add(argumento.id, dir, argumento.tipo, "param", null);
                             dir += tablaTipos.getTam(argumento.tipo);
                         }
                     }
                 }
                 // Mover la impresión aquí, después de procesar toda la función
                 printSemanticInfo("Declaración de Función", 
                     "Nombre: " + $3.getLexema(), Colors.PINK);
             } else {
                 yyerror("Error interno: La función " + $3.getLexema() + " no fue pre-registrada");
             }
             
             // Cerrar el ámbito de la función
             pilaTs.pop();
             dir = pilaDir.pop();
             $$ = new AtribExp();
         }
         decl_func
         {
             $$ = new AtribExp();
         }
         | /* epsilon */
         {
             $$ = new AtribExp();
         }
         ;

// Argumentos de funciones
argumentos : lista_args
          {
              $$ = new AtribExp();
              $$.lista = $1.lista;
          }
          | /* epsilon */
          {
              $$ = new AtribExp();
              $$.lista = new ArrayList<>();
          }
          ;

// Lista de argumentos
lista_args : lista_args COMA tipo ID
          {
              $$ = new AtribExp();
              $$.lista = new ArrayList<>($1.lista);
              $$.lista.add(new Argumento($4.getLexema(), $3.tipo));
          }
          | tipo ID
          {
              $$ = new AtribExp();
              $$.lista = new ArrayList<>();
              $$.lista.add(new Argumento($2.getLexema(), $1.tipo));
          }
          ;

// Bloque de código
bloque : LLAI declaraciones instrucciones LLAD
       {
           $$ = new AtribExp();
       }
       ;

// Declaraciones
declaraciones : decl_var
              {
                  $$ = new AtribExp();
                  $$.tipo = $1.tipo;
              }
              ;

// Instrucciones
instrucciones : instrucciones sentencia
              {
                  $$ = new AtribExp();
              }
              | sentencia
              {
                  $$ = new AtribExp();
              }
              ;

// Sentencias
sentencia : parte_izquierda ASIG exp PYC
         {
             // Asegurarnos de que ambos tipos estén inicializados
             if ($1.tipo == TablaTipos.T_ERROR) {
                 $1.tipo = TablaTipos.T_INT;
             }
             if ($3.tipo == TablaTipos.T_ERROR) {
                 $3.tipo = TablaTipos.T_INT;
             }

             // Verificar compatibilidad de tipos
             if (sonTiposCompatibles($1.tipo, $3.tipo)) {
                 printSemanticInfo("Verificación de Tipos", 
                     "Tipos compatibles: " + obtenerNombreTipo($1.tipo) + 
                     " = " + obtenerNombreTipo($3.tipo), Colors.OLD_GOLD);
                 
                 $$ = new AtribExp();
                 String valorConvertido = convertirTipo($3.dir, $3.tipo, $1.tipo);
                 
                 if ($1.esArray) {
                     genCode($1.base + "[" + $1.dir + "] = " + valorConvertido);
                 } else {
                     genCode($1.id + " = " + valorConvertido);
                 }
             } else {
                 printSemanticInfo("Error de Tipos", 
                     "Tipos incompatibles: " + obtenerNombreTipo($1.tipo) + 
                     " = " + obtenerNombreTipo($3.tipo), Colors.RED);
                 yyerror("Tipos incompatibles en asignación");
             }
         }
         | IF PARI exp PARD sentencia
         {
             String labelTrue = newLabel();
             String labelFalse = newLabel();
             pilaLabelTrue.push(labelTrue);
             pilaLabelFalse.push(labelFalse);
             
             genCode("if " + $3.dir + " goto " + labelTrue);
             genCode("goto " + labelFalse);
             label(labelTrue);
             label(labelFalse);
             
             pilaLabelTrue.pop();
             pilaLabelFalse.pop();
             $$ = new AtribExp();
         }
         | IF PARI exp PARD sentencia ELSE sentencia
         {
             String labelTrue = newLabel();
             String labelFalse = newLabel();
             String labelNext = newLabel();
             
             pilaLabelTrue.push(labelTrue);
             pilaLabelFalse.push(labelFalse);
             pilaLabelNext.push(labelNext);
             
             genCode("if " + $3.dir + " goto " + labelTrue);
             genCode("goto " + labelFalse);
             label(labelTrue);
             genCode("goto " + labelNext);
             label(labelFalse);
             label(labelNext);
             
             pilaLabelTrue.pop();
             pilaLabelFalse.pop();
             pilaLabelNext.pop();
             $$ = new AtribExp();
         }
         | WHILE PARI exp PARD sentencia
         {
             String labelNext = newLabel();
             String labelTrue = newLabel();
             String labelFalse = newLabel();
             
             pilaLabelNext.push(labelNext);
             pilaLabelTrue.push(labelTrue);
             pilaLabelFalse.push(labelFalse);
             
             label(labelNext);
             genCode("if " + $3.dir + " goto " + labelTrue);
             genCode("goto " + labelFalse);
             label(labelTrue);
             genCode("goto " + labelNext);
             label(labelFalse);
             
             pilaLabelTrue.pop();
             pilaLabelFalse.pop();
             pilaLabelNext.pop();
             $$ = new AtribExp();
         }
         | DO sentencia WHILE PARI exp PARD PYC
         {
             $$ = new AtribExp();
             String labelStart = newLabel();
             label(labelStart);
             genCode("if " + $5.dir + " goto " + labelStart);
         }
         | BREAK PYC
         {
             $$ = new AtribExp();
         }
         | bloque
         {
             $$ = new AtribExp();
         }
         | RETURN exp PYC
         {
             if ($2.tipo == TablaTipos.T_ERROR) {
                 $2.tipo = TablaTipos.T_INT;
             }
             
             if (sonTiposRetornoCompatibles(tipoReturnFunc, $2.tipo)) {
                 $$ = new AtribExp();
                 genCode("return " + convertirTipo($2.dir, $2.tipo, tipoReturnFunc));
             } else {
                 yyerror("Tipo de retorno incompatible. Se esperaba " + 
                     obtenerNombreTipo(tipoReturnFunc) + " pero se encontró " + 
                     obtenerNombreTipo($2.tipo));
             }
         }
         | RETURN PYC
         {
             if (tipoReturnFunc == TablaTipos.T_VOID || tipoReturnFunc == TablaTipos.T_ERROR) {
                 $$ = new AtribExp();
                 genCode("return");
             } else {
                 yyerror("Se esperaba un valor de retorno de tipo " + 
                     obtenerNombreTipo(tipoReturnFunc));
             }
         }
         | SWITCH PARI exp PARD LLAI casos LLAD
         {
             $$ = new AtribExp();
         }
         | PRINT exp PYC
         {
             $$ = new AtribExp();
         }
         | SCAN parte_izquierda PYC
         {
             $$ = new AtribExp();
         }
         ;

// Casos de switch
casos : caso casos
      {
          $$ = new AtribExp();
      }
      | /* epsilon */
      {
          $$ = new AtribExp();
      }
      | predeterminado
      {
          $$ = new AtribExp();
      }
      ;

// Caso de switch
caso : CASE opcion DOSP instrucciones
     {
         $$ = new AtribExp();
     }
     ;

// Opción de caso
opcion : LIT_ENTERO
       {
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_INT;
       }
       | LIT_RUNE
       {
           $$ = new AtribExp();
           $$.tipo = TablaTipos.T_RUNE;
       }
       ;

// Caso predeterminado
predeterminado : DEFAULT DOSP instrucciones
               {
                   $$ = new AtribExp();
               }
               ;

// Parte izquierda de una asignación
parte_izquierda : ID localizacion
                {
                    $$ = new AtribExp();
                    $$ = $2;
                    $$.id = $1.getLexema();
                    if (!pilaTs.existe($$.id)) {
                        // Si la variable no existe, crearla en el ámbito actual
                        pilaTs.top().add($$.id, dir, TablaTipos.T_INT, "var", null);
                        dir += tablaTipos.getTam(TablaTipos.T_INT);
                    }
                }
                | ID
                {
                    $$ = new AtribExp();
                    $$.id = $1.getLexema();
                    if (!pilaTs.existe($$.id)) {
                        // Si la variable no existe, crearla en el ámbito actual
                        pilaTs.top().add($$.id, dir, TablaTipos.T_INT, "var", null);
                        dir += tablaTipos.getTam(TablaTipos.T_INT);
                    }
                    $$.tipo = pilaTs.getTipo($$.id);
                }
                ;

// Expresiones
exp : exp OR exp                 /* || */
    {
        if (tablaTipos.sonCompatibles($1.tipo, $3.tipo)) {
            $$ = new AtribExp();
            $$.dir = nuevaTemporal();
            $$.tipo = max($1.tipo, $3.tipo);
            String α1 = ampliar($1.dir, $1.tipo, $$.tipo);
            String α2 = ampliar($3.dir, $3.tipo, $$.tipo);
            genCode($$.dir + " = " + α1 + " || " + α2);
        } else {
            yyerror("Tipos incompatibles en operación lógica OR");
        }
    }
    | exp AND exp                /* && */
    {
        if (tablaTipos.sonCompatibles($1.tipo, $3.tipo)) {
            $$ = new AtribExp();
            $$.dir = nuevaTemporal();
            $$.tipo = max($1.tipo, $3.tipo);
            String α1 = ampliar($1.dir, $1.tipo, $$.tipo);
            String α2 = ampliar($3.dir, $3.tipo, $$.tipo);
            genCode($$.dir + " = " + α1 + " && " + α2);
        } else {
            yyerror("Tipos incompatibles en operación lógica AND");
        }
    }
    | exp AND exp                /* && */
    | exp IGUAL exp              /* == */
    {
        if (tablaTipos.sonCompatibles($1.tipo, $3.tipo)) {
            $$ = new AtribExp();
            $$.dir = nuevaTemporal();
            $$.tipo = max($1.tipo, $3.tipo);
            String α1 = ampliar($1.dir, $1.tipo, $$.tipo);
            String α2 = ampliar($3.dir, $3.tipo, $$.tipo);
            genCode($$.dir + " = " + α1 + " == " + α2);
        } else {
            yyerror("Tipos incompatibles en comparación de igualdad");
        }
    }
    | exp DIFERENTE exp          /* != */
    {
        if (tablaTipos.sonCompatibles($1.tipo, $3.tipo)) {
            $$ = new AtribExp();
            $$.dir = nuevaTemporal();
            $$.tipo = max($1.tipo, $3.tipo);
            String α1 = ampliar($1.dir, $1.tipo, $$.tipo);
            String α2 = ampliar($3.dir, $3.tipo, $$.tipo);
            genCode($$.dir + " = " + α1 + " != " + α2);
        } else {
            yyerror("Tipos incompatibles en comparación de diferencia");
        }
    }
    | exp MENOR exp              /* < */
    {
        if (tablaTipos.sonCompatibles($1.tipo, $3.tipo)) {
            $$ = new AtribExp();
            $$.dir = nuevaTemporal();
            $$.tipo = max($1.tipo, $3.tipo);
            String α1 = ampliar($1.dir, $1.tipo, $$.tipo);
            String α2 = ampliar($3.dir, $3.tipo, $$.tipo);
