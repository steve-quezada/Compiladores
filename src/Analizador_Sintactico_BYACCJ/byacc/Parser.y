// Métodos de procesamiento semántico
private void procesarDeclaracionVariables(int tipo) {
    if (listaVariables.isEmpty()) return;

    for (String id : listaVariables) {
        String tipoStr = obtenerNombreTipo(tipo);
        if (tipo == TablaTipos.T_ERROR || tipo == -1) {
            tipo = TablaTipos.T_INT;
            tipoStr = "int";
        }
        
        // Usar el mismo formato que Declaración de Prototipo
        printSemanticInfo("Declaración de Variable", 
            "Nombre: " + id + 
            "\nTipo: " + tipoStr, 
            Colors.MINT);
    }
    
    listaVariables.clear();
}

/**
 * Inicializa variables si no están definidas
 * @param exp1 Primera expresión a inicializar
 * @param exp2 Segunda expresión a inicializar
 */
private void initializeVariablesIfNeeded(AtribExp exp1, AtribExp exp2) {
    if (exp1.tipo == TablaTipos.T_ERROR) {
        exp1.tipo = TablaTipos.T_INT;
    }
    if (exp2.tipo == TablaTipos.T_ERROR) {
        exp2.tipo = TablaTipos.T_INT;
    }
}

/**
 * Verifica la compatibilidad entre dos tipos
 * @param tipo1 Primer tipo a comparar
 * @param tipo2 Segundo tipo a comparar
 * @return boolean true si los tipos son compatibles
 */
private boolean sonTiposCompatibles(int tipo1, int tipo2) {
    if (tipo1 == TablaTipos.T_ERROR || tipo2 == TablaTipos.T_ERROR) {
        tipo1 = tipo1 == TablaTipos.T_ERROR ? TablaTipos.T_INT : tipo1;
        tipo2 = tipo2 == TablaTipos.T_ERROR ? TablaTipos.T_INT : tipo2;
    }

    String tipo1Str = obtenerNombreTipo(tipo1);
    String tipo2Str = obtenerNombreTipo(tipo2);
    
    // Solo imprimir la verificación una vez y en el lugar correcto
    if (tipo1 == tipo2) {
        return true;
    }

    if (esNumerico(tipo1) && esNumerico(tipo2)) {
        // Imprimir mensaje de conversión implícita solo cuando realmente ocurre
        if (tipo1 != tipo2) {
            printSemanticInfo("Verificación de Tipos", 
                "Conversión numérica implícita: " + tipo1Str + " → " + tipo2Str, 
                Colors.OLD_GOLD);
        }
        return true;
    }

    return false;
}

/**
 * Determina si un tipo es numérico
 * @param tipo Tipo a verificar
 * @return boolean true si es un tipo numérico
 */
private boolean esNumerico(int tipo) {
    return tipo == TablaTipos.T_INT || 
           tipo == TablaTipos.T_FLOAT || 
           tipo == TablaTipos.T_DOUBLE || 
           tipo == TablaTipos.T_COMPLEX;
}

/**
 * Determina si un tipo es booleano
 * @param tipo Tipo a verificar
 * @return boolean true si es tipo booleano
 */
private boolean esBooleano(int tipo) {
    // Considerar TRUE y FALSE como tipos booleanos
    return tipo == TablaTipos.T_BOOL;
}

/**
 * Realiza la conversión entre tipos
 * @param valor Valor a convertir
 * @param tipoOrigen Tipo original
 * @param tipoDestino Tipo destino
 * @return String Expresión con la conversión
 */
private String convertirTipo(String valor, int tipoOrigen, int tipoDestino) {
    if (tipoOrigen == tipoDestino) return valor;
    
    // Manejo especial para conversiones específicas
    if (esNumerico(tipoOrigen) && esNumerico(tipoDestino)) {
        return "(" + obtenerNombreTipo(tipoDestino) + ")" + valor;
    }
    
    return valor;
}

/**
 * Obtiene el nombre legible de un tipo
 * @param tipo Identificador del tipo
 * @return String Nombre del tipo
 */
private String obtenerNombreTipo(int tipo) {
    switch (tipo) {
        case TablaTipos.T_INT: return "int";
        case TablaTipos.T_FLOAT: return "float";
        case TablaTipos.T_DOUBLE: return "double";
        case TablaTipos.T_COMPLEX: return "complex";
        case TablaTipos.T_RUNE: return "rune";
        case TablaTipos.T_STRING: return "string";
        case TablaTipos.T_BOOL: return "bool";
        case TablaTipos.T_VOID: return "void";
        case TablaTipos.T_ERROR: return "tipo no definido";
        default:
            // Para tipos compuestos (arrays y structs)
            if (tablaTipos != null) {
                if (tablaTipos.esArray(tipo)) {
                    int tipoBase = tablaTipos.getTipoBase(tipo);
                    return "array de " + obtenerNombreTipo(tipoBase);
                }
                if (tablaTipos.esStruct(tipo)) {
                    return "struct";
                }
            }
            return "tipo desconocido_" + tipo;
    }
}

/**
 * Verifica la compatibilidad de parámetros en llamadas a función
 * @param argsDeclarados Lista de argumentos en la declaración
 * @param argsLlamada Lista de argumentos en la llamada
 * @return boolean true si los parámetros son compatibles
 */
private boolean sonParametrosCompatibles(List<Object> argsDeclarados, List<Object> argsLlamada) {
    if (argsDeclarados == null && (argsLlamada == null || argsLlamada.isEmpty())) {
        return true;
    }
    if (argsDeclarados == null || argsLlamada == null) {
        return false;
    }
    if (argsDeclarados.size() != argsLlamada.size()) {
        return false;
    }

    for (int i = 0; i < argsDeclarados.size(); i++) {
        Object argDeclarado = argsDeclarados.get(i);
        Object argLlamada = argsLlamada.get(i);

        if (argDeclarado instanceof Argumento) {
            Argumento arg = (Argumento) argDeclarado;
            int tipoDeclarado = arg.tipo;
            int tipoLlamada = (argLlamada instanceof Integer) ? (Integer) argLlamada : TablaTipos.T_ERROR;
            
            if (!sonTiposCompatibles(tipoDeclarado, tipoLlamada)) {
                return false;
            }
        } else {
            return false;
        }
    }
    return true;
}

/**
 * Verifica la compatibilidad en tipos de retorno
 * @param tipoEsperado Tipo de retorno declarado
 * @param tipoActual Tipo de retorno actual
 * @return boolean true si los tipos son compatibles
 */
private boolean sonTiposRetornoCompatibles(int tipoEsperado, int tipoActual) {
    // Si los tipos son iguales
    if (tipoEsperado == tipoActual) return true;

    // Si el tipo esperado no está definido, permitir cualquier tipo
    if (tipoEsperado == TablaTipos.T_ERROR) return true;

    // Para tipos numéricos, permitir conversiones implícitas
    if (esNumerico(tipoEsperado) && esNumerico(tipoActual)) {
        // Evitar pérdida de precisión
        if (getTamanoTipo(tipoEsperado) >= getTamanoTipo(tipoActual)) {
            return true;
        }
    }

    // Casos especiales
    if (tipoEsperado == TablaTipos.T_RUNE && tipoActual == TablaTipos.T_INT) return true;
    if (tipoEsperado == TablaTipos.T_INT && tipoActual == TablaTipos.T_RUNE) return true;

    return false;
}

/**
 * Obtiene el tamaño en bytes de un tipo
 * @param tipo Tipo a consultar
 * @return int Tamaño en bytes
 */
private int getTamanoTipo(int tipo) {
    switch (tipo) {
        case TablaTipos.T_INT: return 4;
        case TablaTipos.T_FLOAT: return 4;
        case TablaTipos.T_DOUBLE: return 8;
        case TablaTipos.T_COMPLEX: return 16;
        case TablaTipos.T_RUNE: return 4;
        default: return 0;
    }
}

/**
 * Procesa la declaración de una función
 * @param nombre Nombre de la función
 * @param tipoRetorno Tipo de retorno
 * @param args Lista de argumentos
 */
private void procesarFuncion(String nombre, int tipoRetorno, List<Object> args) {
    printSemanticInfo("Declaración de Función", 
        "Nombre: " + nombre + "\n│ Tipo retorno: " + obtenerNombreTipo(tipoRetorno), 
        Colors.PINK);
    
    if (args != null && !args.isEmpty()) {
        Colors.println("│ Parámetros:", Colors.BLUE_LIGHT);
        for (Object arg : args) {
            if (arg instanceof Argumento) {
                Argumento argumento = (Argumento) arg;
                Colors.println("│   • " + argumento.id + ": " + 
                    obtenerNombreTipo(argumento.tipo), Colors.GRAY_LIGHT);
            }
        }
    }
}

/**
 * Registra la entrada a un nuevo ámbito
