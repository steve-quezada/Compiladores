<project name="Analizador-Sintactico" default="test-all" basedir=".">
    <!-- Updated properties -->
    <property name="src.dir" value="src/Analizador_Sintactico_BYACCJ"/>
    <property name="bin.dir" value="bin"/>
    <property name="build.dir" value="bin"/>
    <!-- Propiedad por defecto para el archivo de prueba -->
    <property name="test.number" value="1" />
    <property name="test.file" value="${src.dir}/tst/prueba${test.number}_Valida.txt"/>

    <!-- Create required directories -->
    <target name="init">
        <mkdir dir="${bin.dir}"/>
    </target>

    <!-- Generate Lexer and Parser -->
    <target name="generate" depends="init">
        <!-- Generate Lexer -->
        <condition property="jflex.command" value="jflex.bat" else="jflex">
            <os family="windows"/>
        </condition>
        <exec executable="${jflex.command}" failonerror="true">
            <arg value="-d"/>
            <arg value="${src.dir}"/>
            <arg value="${src.dir}/jflex/Lexer.flex"/>
        </exec>

        <!-- Generate Parser with corrected path -->
        <exec executable="byaccj" failonerror="true">
            <arg value="-Jclass=Parser"/>
            <arg value="-Jsemantic=ParserVal"/>
            <arg value="-Jpackage=src.Analizador_Sintactico_BYACCJ"/>
            <arg value="-J"/>
            <arg value="${src.dir}/byacc/Parser.y"/>
        </exec>
        <move todir="${src.dir}">
            <fileset dir="." includes="Parser*.java"/>
        </move>
    </target>

    <!-- Clean build files -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete>
            <fileset dir="${src.dir}" includes="Lexer.java,Parser*.java"/>
            <!-- Agregar patrones para eliminar archivos temporales -->
            <fileset dir="." includes="y.output"/>
            <fileset dir="." includes="yacc.oa*"/>
        </delete>
    </target>

    <!-- Compile all Java files -->
    <target name="compile" depends="clean, generate">
        <mkdir dir="${build.dir}"/>
        
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <pathelement location="${src.dir}"/>
            </classpath>
            <include name="**/*.java"/>
        </javac>
    </target>

    <!-- Run the calculator -->
    <target name="run-test">
        <java classname="src.Analizador_Sintactico_BYACCJ.Main" fork="true" failonerror="false">
            <classpath>
                <pathelement location="${build.dir}"/>
                <pathelement location="."/>
            </classpath>
            <arg value="${file}"/>
        </java>
    </target>

    <!-- Targets específicos para cada prueba -->
    <target name="test0" depends="compile">
        <antcall target="run-test">
            <param name="file" value="${src.dir}/tst/prueba.txt"/>
        </antcall>
    </target>

    <target name="test1" depends="compile">
        <antcall target="run-test">
            <param name="file" value="${src.dir}/tst/prueba1_Valida.txt"/>
        </antcall>
    </target>

    <target name="test2" depends="compile">
        <antcall target="run-test">
            <param name="file" value="${src.dir}/tst/prueba2_Valida.txt"/>
        </antcall>
    </target>

    <target name="test3" depends="compile">
        <antcall target="run-test">
            <param name="file" value="${src.dir}/tst/prueba3_Valida.txt"/>
        </antcall>
    </target>

    <target name="test4" depends="compile">
        <antcall target="run-test">
            <param name="file" value="${src.dir}/tst/prueba4_Valida.txt"/>
        </antcall>
    </target>

    <target name="test5" depends="compile">
        <antcall target="run-test">
            <param name="file" value="${src.dir}/tst/prueba5_Valida.txt"/>
        </antcall>
    </target>

    <target name="test6" depends="compile">
        <antcall target="run-test">
            <param name="file" value="${src.dir}/tst/prueba6_Valida.txt"/>
        </antcall>
    </target>

    <!-- Target para ejecutar todas las pruebas en secuencia -->
    <target name="test-all" description="Ejecuta todas las pruebas">
        <antcall target="test0"/>
        <antcall target="test1"/>
        <antcall target="test2"/>
        <antcall target="test3"/>
        <antcall target="test4"/>
        <antcall target="test5"/>
        <antcall target="test6"/>
    </target>

</project>